{
  "git": {
    "deploymentEnabled": {
      "*": false,
      "dev": false,
      "preview": false,
      "main": true
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/newsletter/monthly-send",
      "schedule": "0 16 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(grow-tech/checkout|grow-tech/thank-you|playbooks/checkout|playbooks/thank-you|auth|shared|checkout-diagnostics|whop-embed-test)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/grow-guides/:slug(cannabis-nutrient-schedule-calculator|cannabis-light-schedule-calculator|best-outdoor-cannabis-growing-apps-2026|ai-plant-diagnosis-apps-compared-2026|cannabis-yield-calculator-guide)",
      "destination": "/grow-guides",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mastergrowbot.com"
        }
      ],
      "destination": "https://www.mastergrowbot.com/:path*",
      "permanent": true
    },
    {
      "source": "/app/:path*",
      "has": [
        {
          "type": "host",
          "value": "mastergrowbot.lovable.app"
        }
      ],
      "destination": "/:path*",
      "permanent": false
    },
    {
      "source": "/ai-strategy",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/ai-strategy/book",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/playbook",
      "destination": "/playbooks",
      "permanent": true
    },
    {
      "source": "/playbook/checkout",
      "destination": "/playbooks/checkout",
      "permanent": true
    },
    {
      "source": "/playbook/thank-you",
      "destination": "/playbooks/thank-you",
      "permanent": true
    }
  ],
  "rewrites": [
